{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install",
      "type": "npm",
      "script": "install",
      "problemMatcher": [],
      "detail": "npm install (birinchi marta yoki package.json o'zgarganda)"
    },
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "educenter-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Server running on port.*$",
          "endsPattern": "^.*Server running on port.*$"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "Serverni development rejimida ishga tushiradi (http://localhost:3000)"
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": "build",
      "detail": "Frontendni dist/ papkasiga yig'adi"
    },
    {
      "label": "start (production)",
      "type": "npm",
      "script": "start",
      "options": { "env": { "NODE_ENV": "production" } },
      "problemMatcher": [],
      "dependsOn": "build",
      "detail": "Build qilib, production rejimida ishga tushiradi"
    }
  ]
}
